# Copy to .env (git ignores .env) to turn on "orders go into a Google Sheet".
# On Vercel / Netlify, set these as environment variables instead and redeploy.
# Leave them unset and the site just uses WhatsApp (the default, and what the public demo does).
VITE_ORDERS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
VITE_ORDERS_TOKEN=the-same-secret-you-put-in-Code.gs
